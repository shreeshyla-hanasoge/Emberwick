{
  "name": "emberwick",
  "version": "0.6.1",
  "description": "Smooth flowing candlestick charts for the web — canvas-rendered, zero-dependency, pluggable data feeds.",
  "license": "MIT",
  "author": "Shreeshyla Hanasoge <shreeshyla.hanasoge@gmail.com>",
  "homepage": "https://emberwick.ldio.app",
  "bugs": {
    "url": "https://github.com/shreeshyla-hanasoge/Emberwick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreeshyla-hanasoge/Emberwick.git"
  },
  "type": "module",
  "sideEffects": [
    "./webcomponent.js"
  ],
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "unpkg": "./umd/emberwick.umd.js",
  "jsdelivr": "./umd/emberwick.umd.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./webcomponent": {
      "types": "./webcomponent.d.ts",
      "import": "./webcomponent.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "candlestick",
    "chart",
    "charting",
    "financial",
    "trading",
    "ohlc",
    "canvas",
    "realtime",
    "tradingview-alternative"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
